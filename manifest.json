{
    "manifest_version": 3,
    "name": "CEISA 4.0 Automation",
    "version": "2.1.5",
    "description": "Smart Customs Automation Hub & CEISA 4.0 Suite.",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "key": "",
    "permissions": [
        "storage",
        "offscreen",
        "activeTab",
        "nativeMessaging"
    ],
    "host_permissions": [
        "https://portal.beacukai.go.id/*",
        "https://script.google.com/*",
        "https://*.googleusercontent.com/*",
        "https://api.github.com/*",
        "https://raw.githubusercontent.com/*",
        "https://github.com/*",
        "https://codeload.github.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
    ],
    "externally_connectable": {
        "matches": [
            "http://localhost/*",
            "http://127.0.0.1/*",
            "https://portal.beacukai.go.id/*"
        ]
    },
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "CEISA 4.0 Automation",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "https://portal.beacukai.go.id/*"
            ],
            "js": [
                "config.js",
                "sync.js",
                "content.js"
            ],
            "run_at": "document_start",
            "all_frames": false
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "inject.js"
            ],
            "matches": [
                "https://portal.beacukai.go.id/*"
            ]
        }
    ]
}