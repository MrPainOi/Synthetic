{
    "manifest_version": 3,

    "name": "CEISA Auto Coloring",
    "version": "2.0.0",

    "description": "Auto coloring dokumen CEISA berdasarkan lokasi/pelabuhan dan nomor pendaftaran.",

    "key": "",

    "permissions": [
        "storage",
        "offscreen",
        "activeTab",
        "nativeMessaging"
    ],

    "host_permissions": [
        "https://portal.beacukai.go.id/*",
        "https://*.supabase.co/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
    ],

    "externally_connectable": {
        "matches": [
            "http://localhost/*",
            "http://127.0.0.1/*",
            "https://portal.beacukai.go.id/*"
        ]
    },

    "background": {
        "service_worker": "background.js"
    },

    "action": {
        "default_title": "CEISA Auto Coloring",
        "default_popup": "popup.html"
    },

    "content_scripts": [
        {
            "matches": [
                "https://portal.beacukai.go.id/*"
            ],
            "js": [
                "config.js",
                "sync.js",
                "content.js"
            ],
            "run_at": "document_start",
            "all_frames": false
        }
    ],

    "web_accessible_resources": [
        {
            "resources": [
                "inject.js"
            ],
            "matches": [
                "https://portal.beacukai.go.id/*"
            ]
        }
    ]
}